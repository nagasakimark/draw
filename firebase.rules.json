{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".write": "auth != null && $code.matches(/^[A-Z0-9]{6}$/) && data.child('meta/hostUid').val() == auth.uid",
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && $code.matches(/^[A-Z0-9]{6}$/) && ((!data.exists() && newData.child('hostUid').val() == auth.uid) || (data.exists() && data.child('hostUid').val() == auth.uid))",
          ".validate": "!newData.exists() || (newData.hasChildren(['hostUid', 'createdAt', 'expiresAt']) && newData.child('hostUid').isString())",
          "hostUid": { ".validate": "newData.isString() && newData.val().length <= 128" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "expiresAt": { ".validate": "newData.isNumber()" },
          "hb": { ".validate": "newData.isNumber()" },
          "closed": { ".validate": "newData.isBoolean()" },
          "config": { ".validate": "newData.hasChildren()" },
          "$other": { ".validate": "false" }
        },
        "signal": {
          ".read": "auth != null && root.child('rooms').child($code).child('meta/hostUid').val() == auth.uid",
          "$sid": {
            ".read": "auth != null && $sid.beginsWith(auth.uid)",
            ".write": "auth != null && root.child('rooms').child($code).child('meta').exists() && ($sid.beginsWith(auth.uid) || root.child('rooms').child($code).child('meta/hostUid').val() == auth.uid)",
            ".validate": "!newData.exists() || newData.hasChildren(['state'])",
            "offer": { ".validate": "newData.hasChildren(['type', 'sdp']) && newData.child('sdp').isString() && newData.child('sdp').val().length < 12000" },
            "answer": { ".validate": "newData.hasChildren(['type', 'sdp']) && newData.child('sdp').isString() && newData.child('sdp').val().length < 12000" },
            "offerSeq": { ".validate": "newData.isNumber()" },
            "answerSeq": { ".validate": "newData.isNumber()" },
            "state": { ".validate": "newData.isString()" },
            "updatedAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": "false" }
          }
        }
      }
    }
  }
}
