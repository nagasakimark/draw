{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$roomId": {
        ".read": "auth != null && $roomId.matches(/^[A-Z0-9]{6,12}$/)",
        ".write": "auth != null && $roomId.matches(/^[A-Z0-9]{6,12}$/) && (
          (!data.exists() && newData.exists() && newData.child('ownerId').val() == auth.uid && newData.child('code').val() == $roomId) ||
          (data.exists() && newData.exists() && newData.child('code').val() == $roomId) ||
          (data.exists() && !newData.exists())
        )",
        ".validate": "newData.hasChildren(['code', 'ownerId', 'createdAt', 'expiresAt', 'phase', 'settings', 'players'])",
        "code": {
          ".validate": "newData.isString() && newData.val() == $roomId"
        },
        "ownerId": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "expiresAt": {
          ".validate": "newData.isNumber()"
        },
        "phase": {
          ".validate": "newData.isString()"
        },
        "settings": {
          ".validate": "newData.hasChildren(['rounds', 'drawingTime', 'maxPlayers', 'deckId', 'deckName'])"
        },
        "players": {
          "$playerId": {
            ".write": "auth != null && auth.uid == $playerId",
            ".validate": "newData.hasChildren(['name', 'score', 'connected'])"
          }
        },
        "chat": {
          "$chatId": {
            ".validate": "newData.hasChildren(['text', 'createdAt']) && newData.child('text').isString() && newData.child('text').val().length <= 120"
          }
        }
      }
    }
  }
}
